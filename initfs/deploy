#!/bin/sh
set -eu

. /tmp/versions.env

fetch_source() {
    repo="$1"
    ref="$2"
    dest="$3"
    mkdir -p "$dest"
    wget -O /tmp/source.tar.gz "https://github.com/imsyy/$repo/archive/$ref.tar.gz"
    tar -xzf /tmp/source.tar.gz -C "$dest" --strip-components=1
    rm /tmp/source.tar.gz
}

mkdir -p /var/www
fetch_source DailyHotApi "$DAILYHOT_API_REF" /tmp/api-build
cd /tmp/api-build
pnpm install --frozen-lockfile
pnpm run build
pnpm prune --prod
mkdir -p /var/www/api
cp -a dist/. /var/www/api/
cp -a package.json node_modules public /var/www/api/
cp .env.example /var/www/api/.env

fetch_source DailyHot "$DAILYHOT_REF" /tmp/front-build
cd /tmp/front-build
sed -i "s|Copyright By|$(date +'%Y')|" src/components/Footer.vue
sed -i 's|"author": "imsyy"|"author": "APP_COPYRIGHT"|' package.json
sed -i 's|"github": "https://github.com/imsyy"|"github": "APP_COPYRIGHT_URL"|' package.json
printf '%s\n' 'VITE_GLOBAL_API=/api' 'VITE_ICP=APP_ICP' 'VITE_DIR=/' > .env
pnpm install --frozen-lockfile
pnpm run build
mv dist /var/www/front
